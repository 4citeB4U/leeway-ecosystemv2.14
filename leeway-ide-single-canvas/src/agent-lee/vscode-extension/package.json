    "scripts": {
        "sync-release-metadata": "node ./scripts/sync-release-metadata.mjs",
        "sanitize:release-state": "node ./scripts/sanitize-release-state.mjs",
        "clean:out": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
        "build:info": "node ./scripts/write-build-info.mjs",
        "compile": "npm run clean:out && tsc -p ./ && npm run bundle && npm run build:info",
        "bundle": "node ./scripts/bundle-extension.mjs",
        "package:vsix": "npm run sync-release-metadata && npm run sanitize:release-state && npm run compile && node ./scripts/package-release.mjs",
        "package": "npm run package:vsix",
        "upgrade:host": "npm run package:vsix && powershell -NoProfile -ExecutionPolicy Bypass -Command \"$vsix = Resolve-Path './agent-lee-leeway-coding-system-'+(node -p \"require('./package.json').version\")+'.vsix'; & \"$env:LOCALAPPDATA\\Programs\\Microsoft VS Code\\bin\\code.cmd\" --install-extension $vsix --force; Write-Host 'Installed latest local VSIX. Run: Developer: Reload Window'\"",
        "LEEWAY_CONSTRUCTION_LAW_GATE": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Invoke-LeeWayConstructionLawGate.ps1",
        "LEEWAY_IDENTITY_PULSE_GATE": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Invoke-LeeWayIdentityPulseGate.ps1",
        "LEEWAY_IDENTITY_MESH_GATE": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Invoke-LeeWayIdentityMeshGate.ps1",
        "LEEWAY_TRACER_PACK_GATE": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Invoke-LeeWayTracerPackGate.ps1",
        "LEEWAY_APPLICATION_INTEGRITY_GATE": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Invoke-LeeWayApplicationIntegrityGate.ps1",
        "LEEWAY_GENERATED_APP_HARNESS_GATE": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Invoke-LeeWayGeneratedAppHarness.ps1",
        "LEEWAY_EXTENSION_ASSET_CHECK": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Invoke-LeeWayExtensionAssetCheck.ps1",
        "LEEWAY_EXTENSION_DEV_RELOAD": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Invoke-LeeWayExtensionDevReload.ps1 -SkipLaunch",
        "LEEWAY_EXTENSION_RELEASE_PACKAGE": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Invoke-LeeWayExtensionReleasePackage.ps1",
        "LEEWAY_EXTENSION_INSTALLED_CHECK": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Invoke-LeeWayInstalledExtensionCheck.ps1"
    },
