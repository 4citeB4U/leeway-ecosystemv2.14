{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeeWay Proof Backed Receipt",
  "type": "object",
  "required": [
    "receiptId",
    "timestamp",
    "laneId",
    "laneName",
    "claimedStatus",
    "correctedStatus",
    "requiredProofLevel",
    "actualProofLevel",
    "passFailRule",
    "verdict"
  ],
  "properties": {
    "receiptId": { "type": "string" },
    "timestamp": { "type": "string" },
    "laneId": { "type": "string" },
    "laneName": { "type": "string" },
    "claimedStatus": { "type": ["string", "null"] },
    "correctedStatus": { "type": "string" },
    "requiredProofLevel": { "type": "string" },
    "actualProofLevel": { "type": "string" },
    "commandRun": { "type": ["string", "null"] },
    "commandExitCode": { "type": ["integer", "null"] },
    "rawStdoutPath": { "type": ["string", "null"] },
    "rawStderrPath": { "type": ["string", "null"] },
    "endpointUrl": { "type": ["string", "null"] },
    "rawEndpointResponsePath": { "type": ["string", "null"] },
    "artifactPaths": { "type": "array", "items": { "type": "string" } },
    "audioProofPath": { "type": ["string", "null"] },
    "imageProofPath": { "type": ["string", "null"] },
    "screenshotProofPath": { "type": ["string", "null"] },
    "modelRawRequestPath": { "type": ["string", "null"] },
    "modelRawResponsePath": { "type": ["string", "null"] },
    "serviceName": { "type": ["string", "null"] },
    "processId": { "type": ["integer", "null"] },
    "containerName": { "type": ["string", "null"] },
    "port": { "type": ["integer", "null"] },
    "healthResponse": {},
    "passFailRule": { "type": "string" },
    "blocker": { "type": ["string", "null"] },
    "proofGap": { "type": ["string", "null"] },
    "truthLabels": { "type": "array", "items": { "type": "string" } },
    "verdict": { "type": "string" }
  }
}

